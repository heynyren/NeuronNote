# ─────────────────────────────────────────────
#  NeuronNote — .gitignore
#  Loại bỏ file rác / file build / thư viện tải về
# ─────────────────────────────────────────────

# --- Node / npm (app Android dùng Capacitor) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Android / Gradle (file build tự sinh) ---
.gradle/
**/build/
*.apk
*.aab
*.ap_
*.dex
local.properties
.cxx/
captures/
*.keystore
*.jks

# --- Capacitor (thư mục native tự sinh khi chạy `npx cap sync`) ---
# Giữ lại mã nguồn, chỉ loại phần build/tạm.
android-app/android/app/src/main/assets/public/

# --- Gói phát hành (.zip) — nên dùng GitHub Releases thay vì commit ---
*.zip

# --- Hệ điều hành / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*~

# --- File môi trường / bí mật (đừng bao giờ commit) ---
.env
.env.*
secrets.json
*.local
node_modules/

# --- Ảnh chụp màn hình do bộ thử Playwright ghi ra ---
# Chúng rơi thẳng vào thư mục extension mỗi lần chạy thử, làm bẩn cây làm việc
# và dễ bị commit nhầm. Ảnh dùng cho README thì đặt ở nơi khác và theo dõi bình
# thường, chứ không phải mấy tệp tự sinh này.
neuron-note/nn-*.png
